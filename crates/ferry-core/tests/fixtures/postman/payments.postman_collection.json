{
	"info": {
		"_postman_id": "6f1e2a7c-3b0d-4b8e-9d6a-2c51f0e8a913",
		"name": "Payments API",
		"description": {
			"content": "Charges, refunds and customers.",
			"type": "text/markdown"
		},
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "1234567"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Log in",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
									"pm.environment.set(\"token\", pm.response.json().token);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "X-Trace",
								"value": "on",
								"type": "text",
								"disabled": true
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user\": \"ada\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Returns a token."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\"user\":\"ada\"}"
								},
								"url": {
									"raw": "{{baseUrl}}/login",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"login"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\"token\":\"t-1\"}"
						}
					]
				}
			],
			"auth": {
				"type": "basic",
				"basic": [
					{
						"key": "password",
						"value": "s3cret",
						"type": "string"
					},
					{
						"key": "username",
						"value": "ada",
						"type": "string"
					}
				]
			},
			"variable": [
				{
					"key": "folderOnly",
					"value": "1"
				}
			]
		},
		{
			"name": "Charges",
			"item": [
				{
					"name": "List charges",
					"protocolProfileBehavior": {
						"followRedirects": false,
						"strictSSL": false,
						"disableCookies": true
					},
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/charges?limit=10&cursor={{cursor}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"charges"
							],
							"query": [
								{
									"key": "limit",
									"value": "10",
									"description": "At most 100."
								},
								{
									"key": "status",
									"value": "paid",
									"disabled": true
								},
								{
									"key": "cursor",
									"value": "{{cursor}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create charge",
					"request": {
						"auth": {
							"type": "ntlm",
							"ntlm": [
								{
									"key": "username",
									"value": "ada",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "amount",
									"value": "500",
									"type": "text"
								},
								{
									"key": "currency",
									"value": "usd",
									"type": "text",
									"disabled": true,
									"description": "Defaults to usd."
								}
							]
						},
						"url": "{{baseUrl}}/charges"
					},
					"response": []
				},
				{
					"name": "Upload receipt",
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "note",
									"value": "March",
									"type": "text"
								},
								{
									"key": "receipt",
									"type": "file",
									"src": [
										"/home/ada/receipt.pdf",
										"/home/ada/receipt2.pdf"
									]
								},
								{
									"key": "empty",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/charges/:id/receipt",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"charges",
								":id",
								"receipt"
							],
							"variable": [
								{
									"key": "id",
									"value": "ch_1"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Import charges",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "file",
							"file": {
								"src": "/home/ada/charges.csv"
							}
						},
						"url": {
							"protocol": "https",
							"host": [
								"api",
								"pay",
								"test"
							],
							"port": "8443",
							"path": [
								"v1",
								"import"
							],
							"query": [
								{
									"key": "dry",
									"value": "1"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Charge graph",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "query { charges { id } }",
						"variables": "{\"first\": 2}"
					}
				},
				"url": {
					"raw": "{{baseUrl}}/graphql",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"graphql"
					]
				}
			},
			"response": []
		},
		{
			"name": "Health",
			"request": "https://api.pay.test/health",
			"response": []
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"console.log(\"start\");"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://api.pay.test",
			"type": "string"
		},
		{
			"key": "apiKey",
			"value": "sk_live",
			"type": "secret"
		},
		{
			"key": "old",
			"value": "x",
			"disabled": true
		}
	]
}
