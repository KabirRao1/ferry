package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	url := "https://api.test/users?tag=a%20b"
	payload := strings.NewReader("{\n  \"name\": \"Ada \\\"L\\\"\",\n  \"tab\": \"\t\"\n}")

	client := &http.Client{}
	req, err := http.NewRequest("POST", url, payload)
	if err != nil {
		fmt.Println(err)
		return
	}
	req.Header.Add("X-Note", "it's \"quoted\" $HOME #{x} \\ ok")
	req.Header.Add("Content-Type", "application/json")
	req.Header.Add("Authorization", "Bearer t0k")

	res, err := client.Do(req)
	if err != nil {
		fmt.Println(err)
		return
	}
	defer res.Body.Close()

	body, err := io.ReadAll(res.Body)
	if err != nil {
		fmt.Println(err)
		return
	}
	fmt.Println(string(body))
}
