source: crates/ferry-core/tests/codegen.rs
expression: lang.generate(&s)
---
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.test/upload")!, timeoutInterval: Double.infinity)
request.httpMethod = "POST"
var body = Data()
body.append("------FerryFormBoundary\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nHoliday\r\n".data(using: .utf8)!)
body.append("------FerryFormBoundary\r\nContent-Disposition: form-data; name=\"photo\"; filename=\"beach.jpg\"\r\n\r\n".data(using: .utf8)!)
body.append(try Data(contentsOf: URL(fileURLWithPath: "/home/ada/pics/beach.jpg")))
body.append("\r\n".data(using: .utf8)!)
body.append("------FerryFormBoundary--\r\n".data(using: .utf8)!)
request.addValue("multipart/form-data; boundary=----FerryFormBoundary", forHTTPHeaderField: "Content-Type")
request.httpBody = body

let task = URLSession.shared.dataTask(with: request) { data, response, error in
    guard let data = data else {
        print(String(describing: error))
        return
    }
    print(String(data: data, encoding: .utf8)!)
}
task.resume()
