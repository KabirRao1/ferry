const headers = new Headers();
headers.append("Content-Type", "application/x-www-form-urlencoded");

const body = new URLSearchParams();
body.append("q", "a b&c");
body.append("n", "1");

const response = await fetch("https://api.test/form", {
  method: "PUT",
  headers,
  body,
  redirect: "follow",
});
console.log(await response.text());
