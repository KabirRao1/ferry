var handler = new HttpClientHandler();
handler.AllowAutoRedirect = false;
handler.ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
var client = new HttpClient(handler);
var request = new HttpRequestMessage(new HttpMethod("PURGE"), "https://api.test/cache");
request.Content = new ByteArrayContent(File.ReadAllBytes("data.bin"));
request.Content.Headers.ContentType = System.Net.Http.Headers.MediaTypeHeaderValue.Parse("application/octet-stream");
var response = await client.SendAsync(request);
Console.WriteLine(await response.Content.ReadAsStringAsync());
