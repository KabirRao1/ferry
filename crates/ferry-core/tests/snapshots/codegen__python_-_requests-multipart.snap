import requests

url = "https://api.test/upload"
headers = {}
files = [
    ("title", (None, "Holiday")),
    ("photo", ("beach.jpg", open("/home/ada/pics/beach.jpg", "rb"))),
    ("notes", ("notes.txt", open("notes.txt", "rb"))),
]

response = requests.request("POST", url, headers=headers, files=files)

print(response.text)
